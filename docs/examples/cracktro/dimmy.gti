; /cracktro/dimmy.gti -- copy this to the SD card as /cracktro/dimmy.gti
; Then set CRACKTRO=dimmy (or CRACKTRO=CUSTOM) in CONFIG.TXT.
GTICRACK 1
NAME=Omegaware
AUTHOR=Dimmy

[PATTERN]
FX=COPPER
TIME=4000
TITLE=OMEGAWARE
SUB=* MEZ & DIMMY *
COL=FFE000
SCROLL=ON

[PATTERN]
FX=SYNTH
TIME=4000
TITLE=GTi
SUB=THE FLOPPY FLINGER THINGER
SCROLL=ON

[SCROLL]
TEXT=OMEGAWARE PRESENTS ... THE GTi ... YOUR OWN CRACKTRO, LOADED FROM SD ... GREETINGS TO EVERYONE KEEPING THE SCENE ALIVE ... NOW GO LOAD A GAME ...
